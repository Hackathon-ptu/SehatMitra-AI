# Backend Environment Configuration
PROJECT_NAME="SehatMitra-AI"
SECRET_KEY="your-secret-key-for-jwt-use-a-secure-random-value"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Runtime environment: development | staging | production
APP_ENV="development"

# Local SQLite - development only
DATABASE_URL="sqlite:///./sehatmitra.db"

# Turso Cloud (libSQL) - used for staging and production.
# TURSO_AUTH_TOKEN is a SECRET: put the real value in backend/.env locally,
# or in the Render Environment dashboard. Never commit it.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Groq and Gemini API Configurations
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# SMTP Configurations
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_NAME="SehatMitra-AI"

# Bhashini Configurations (Government of India translation APIs)
BHASHINI_USER_ID="your_bhashini_user_id_here"
BHASHINI_API_KEY="your_bhashini_api_key_here"
BHASHINI_PIPELINE_ID="64392f96daac500b55c543d6"
BHASHINI_CONFIG_URL="https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline"
